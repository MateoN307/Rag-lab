# Copy this file to `.env` (which is gitignored) and fill in the real values
# for your machine. Anything that's a machine-specific absolute path —
# personal directories, local model paths, etc. — belongs here, not in the
# source code, so it never gets committed.

VAULT_PATH=/path/to/your/obsidian/vault

# Optional, for scripts/evaluate.py: a JSON file of evaluation questions
# about your own vault (keep it outside the repo; see design/stage5_evaluation.md).
EVAL_PATH=/path/to/your/eval/questions.json

# Optional: folders (relative to the vault) to leave out of the index,
# separated by ";", e.g. templates.
SKIP_FOLDERS=Templates;Archive/Old

# Optional: where the vector database lives (default: app/db). Use one
# database per vault, e.g. DB_DIR=demo/db for the demo vault.
DB_DIR=app/db
